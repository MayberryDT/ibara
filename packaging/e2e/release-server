#!/usr/bin/env python3
"""GitHub's release downloads, over HTTPS, inside the E2E container.

    release-server OWNER/REPO RELEASES_DIR CERT KEY

RELEASES_DIR holds one folder per release tag with its files, and a file
`latest` naming the tag GitHub would mark Latest. Serves on 127.0.0.1:443 the
two hops GitHub answers with, so curl follows the same redirects it does there:

  https://github.com/OWNER/REPO/releases/latest/download/FILE
      302 -> https://github.com/OWNER/REPO/releases/download/TAG/FILE
  https://github.com/OWNER/REPO/releases/download/TAG/FILE
      302 -> https://release-assets.githubusercontent.com/github-production-release-asset/TAG/FILE?sig=…
      (404 when the release has no such file)
  https://release-assets.githubusercontent.com/github-production-release-asset/TAG/FILE
      200, the file

container.sh points both host names at 127.0.0.1 and trusts CERT's CA inside
the container only.
"""
import http.server
import re
import ssl
import sys
from pathlib import Path

GITHUB = "github.com"
ASSETS = "release-assets.githubusercontent.com"
NAME = re.compile(r"^[A-Za-z0-9._-]+$")

repo, releases, cert, key = sys.argv[1], Path(sys.argv[2]), sys.argv[3], sys.argv[4]


def safe(*parts):
    return all(NAME.match(p) and p not in (".", "..") for p in parts)


class Handler(http.server.BaseHTTPRequestHandler):
    def reply(self, status, location=None, body=None):
        self.send_response(status)
        if location:
            self.send_header("Location", location)
        self.send_header("Content-Type", "application/octet-stream" if body is not None else "text/plain")
        self.send_header("Content-Length", str(len(body) if body is not None else 0))
        self.end_headers()
        if body is not None and self.command == "GET":
            self.wfile.write(body)

    def do_GET(self):
        host = (self.headers.get("Host") or "").split(":")[0]
        path = self.path.split("?")[0]
        if host == GITHUB:
            m = re.fullmatch(rf"/{re.escape(repo)}/releases/latest/download/([^/]+)", path)
            if m and safe(m[1]) and (releases / "latest").is_file():
                tag = (releases / "latest").read_text().strip()
                return self.reply(302, f"https://{GITHUB}/{repo}/releases/download/{tag}/{m[1]}")
            m = re.fullmatch(rf"/{re.escape(repo)}/releases/download/([^/]+)/([^/]+)", path)
            if m and safe(m[1], m[2]) and (releases / m[1] / m[2]).is_file():
                return self.reply(302, f"https://{ASSETS}/github-production-release-asset/{m[1]}/{m[2]}?sig=e2e")
        elif host == ASSETS:
            m = re.fullmatch(r"/github-production-release-asset/([^/]+)/([^/]+)", path)
            if m and safe(m[1], m[2]) and (releases / m[1] / m[2]).is_file():
                return self.reply(200, body=(releases / m[1] / m[2]).read_bytes())
        self.reply(404)

    do_HEAD = do_GET


server = http.server.ThreadingHTTPServer(("127.0.0.1", 443), Handler)
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain(cert, key)
server.socket = context.wrap_socket(server.socket, server_side=True)
server.serve_forever()
