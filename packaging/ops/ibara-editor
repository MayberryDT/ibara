#!/usr/bin/env bash
set -euo pipefail
export XDG_CONFIG_HOME="${IBARA_DATA_DIR:-$HOME/.local/share/agent-computer}/editor-config"
export GSETTINGS_BACKEND=keyfile
mkdir -p "$XDG_CONFIG_HOME"
chmod 0700 "$XDG_CONFIG_HOME"
# Never ask to restore a previous session: an editor closed at a task's end
# can look like a crash, and the prompt would take the agent's keystrokes.
gsettings set org.xfce.mousepad.preferences.file session-restore never
exec /usr/bin/mousepad --disable-server "$@"
