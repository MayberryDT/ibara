#!/bin/bash
# Stand-in for Omarchy's shell IPC in the E2E container: records each call and
# keeps which plugins are enabled in ~/.omarchy-stub-enabled.
printf 'omarchy-shell %s\n' "$*" >>"$HOME/omarchy-stub.log"
state=$HOME/.omarchy-stub-enabled
case "$1 $2" in
  "shell ping") echo pong ;;
  "shell rescanPlugins") ;;
  "shell listPlugins")
    if [[ -f $state ]]; then echo '[{"id":"io.zet.ibara","enabled":true}]'; else echo '[]'; fi ;;
  "shell putBarWidget" | "shell enablePlugin") touch "$state"; echo ok ;;
  "shell setPluginEnabled") if [[ $4 == false ]]; then rm -f "$state"; else touch "$state"; fi; echo ok ;;
  *) echo "unknown"; exit 1 ;;
esac
