[Unit]
Description=ibara restart, shut down, sleep, update or browser setup request
Requires=ibara-power.socket
After=ibara-power.socket
CollectMode=inactive-or-failed

[Service]
Type=exec
User=root
Group=root
# One JSON request per connection: disk, restart, shutdown, sleep,
# update_ibara, update_omarchy, browser_setup or browser_remove. The reply is
# sent before systemctl runs; an update runs as its own unit
# (ibara-update.service or ibara-omarchy-update.service), started before the
# reply. browser_setup and browser_remove run the ibara program below with
# `browser-setup` for the account that opened the socket (Default profile
# only) and relay its report.
ExecStart=/usr/bin/ibara power-system
Environment=IBARA_POWER_IBARA=/usr/lib/ibara/bin/ibara
Environment=IBARA_POWER_EXTENSION_DIR=/usr/lib/ibara/chrome-extension
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
# systemd-cryptenroll reads the LUKS header from the disk device, so the real
# /dev stays visible.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# D-Bus to systemd and logind, nl80211 for Wi-Fi wake, and a datagram socket
# for wired wake-on-LAN. Update preflight also fetches the signed release
# manifest before deciding whether an update unit is needed.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
RuntimeMaxSec=30s
MemoryMax=64M
TasksMax=16
