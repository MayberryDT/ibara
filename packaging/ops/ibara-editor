#!/usr/bin/env bash
set -euo pipefail
# The editor uses the person's own Mousepad settings, so what `gsettings`
# shows is what the editor uses. One of them is kept off: session restore.
# An editor closed at a task's end can look like a crash, and the "restore
# the previous session?" prompt would take the agent's keystrokes. Mousepad
# has no option to skip it for one launch, so the setting is turned off,
# written only when it is not off already. Mousepad turns its autosave off
# with it.
key=(org.xfce.mousepad.preferences.file session-restore)
if [[ "$(gsettings get "${key[@]}")" != "'never'" ]]; then
  gsettings set "${key[@]}" never
fi
exec /usr/bin/mousepad --disable-server "$@"
