#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$root/scripts/validate_manifest.py" "$root"
# A QML syntax error only surfaces when the shell loads the plugin; catch it here.
qmllint="$(command -v qmllint || echo /usr/lib/qt6/bin/qmllint)"
if [[ -x "$qmllint" ]]; then
  for file in "$root"/*.qml; do
    if "$qmllint" "$file" 2>&1 | grep -q '\[syntax\]'; then printf 'QML syntax error in %s\n' "$file" >&2; exit 1; fi
  done
fi
node --test "$root/tests/"*.test.mjs
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi
printf 'All portable plugin checks passed.\n'
