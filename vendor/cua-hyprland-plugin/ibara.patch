+// ibara: the seat's pointer when no mouse is plugged in. Hyprland offers apps
+// a pointer, and gives pointer focus, only while some pointer device exists,
+// so on a computer without a mouse every foreground click was refused
+// (`physical_pointer`) and no app held a pointer to receive one. This device
+// is registered for the plugin's lifetime on every computer, mouse or not. It
+// never sends an event: it cannot move the pointer or press a button, so
+// nothing it does can count as a person. A person's mouse, touchpad, keys,
+// touch and tablet still interrupt the agent as before.
+struct InputExperiment::AgentPointer {
+    class Device final : public IPointer {
+      public:
+        static SP<Device> create() {
+            auto device = SP<Device>(new Device());
+            device->m_self = device;
+            return device;
+        }
+        bool isVirtual() override { return true; }
+        SP<Aquamarine::IPointer> aq() override { return nullptr; }
+
+      private:
+        Device() { m_deviceName = "ibara agent pointer"; }
+    };
+    SP<Device> device = Device::create();
+
+    AgentPointer() {
+        g_pInputManager->newMouse(SP<IPointer>(device));
+        g_pInputManager->updateCapabilities();
+    }
+    ~AgentPointer() {
+        // Hyprland drops the device on this signal. Nothing may keep it past
+        // here: its code leaves with the module.
+        device->m_events.destroy.emit();
+        device.reset();
+        g_pInputManager->updateCapabilities();
+    }
+};
