# Where ibara's releases are published, and the public half of the key that
# signs them. The package, `ibara update` and the published install script all
# read them from here (packaging/release.sh). Empty values build an ibara with
# no update channel: `ibara update` then says so.
#
# IBARA_BASE_URL     the folder holding install, stable.json, stable.json.sig
#                    and the packages. Releases are GitHub releases of
#                    MayberryDT/ibara (packaging/publish.sh), so this is the
#                    newest release's downloads: GitHub redirects each file to
#                    the release that is marked Latest.
# IBARA_RELEASE_KEY  an ssh-ed25519 public key line (ssh-keygen -t ed25519);
#                    its private half signs stable.json (release.sh --sign-key).
#                    packaging/publish.sh reads it from
#                    ~/.config/ibara-release/ibara-release by default.
# Keep the values in double quotes: packaging/release.sh reads this file as shell.
IBARA_BASE_URL="https://github.com/MayberryDT/ibara/releases/latest/download"
IBARA_RELEASE_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHxVwzeqzB+dhtiZ/s8LW6cPPHKbxNi2m6/XLVTQdMjE ibara-release"
