{
  "schemaVersion": 1,
  "id": "io.zet.ibara",
  "name": "ibara",
  "version": "0.2.0",
  "author": "Tyler Mayberry",
  "license": "MIT",
  "description": "Your computers in the Omarchy bar through ibara: what needs you at a glance, approvals, and the full console.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Console.qml"
  },
  "barWidget": {
    "displayName": "ibara",
    "description": "ibara status. Click for quick controls; right-click for the full console.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "openRefreshSec": 5,
      "closedRefreshSec": 15,
      "request_popups": true,
      "popup_approvals": true,
      "popup_logins": true,
      "popup_questions": true,
      "popup_dnd": false,
      "popup_desktop_notifications": false
    },
    "schema": [
      {
        "key": "openRefreshSec",
        "type": "integer",
        "label": "Refresh While Open (Seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "closedRefreshSec",
        "type": "integer",
        "label": "Refresh While Hidden (Seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
